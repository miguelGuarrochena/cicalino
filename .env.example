# ==========================================================================
# Cicalino - variables de entorno (PLANTILLA)
# Copiar a .env.local y completar con valores reales.
# ⚠️ NUNCA poner claves/contraseñas reales acá: .env.example SE COMMITEA a git.
# ==========================================================================

# --- Supabase (backend + auth + realtime) ---
# Dashboard del proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
# Publishable key (segura para el navegador). Debe ir con NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# SECRET key: SOLO server, NUNCA exponer ni commitear. Va únicamente en .env.local / Vercel.
# (también acepta el nombre viejo SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SECRET_KEY="sb_secret_xxx"

# --- Base de datos (solo para migraciones Drizzle en local) ---
# Supabase → Settings → Database → Connection string (pooler).
# Si la contraseña tiene caracteres especiales (& @ : / ?), codificalos (& = %26).
DATABASE_URL="postgresql://postgres:TU-PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# En Vercel: solo la URL limpia, sin espacios ni comentarios.
# Ej: https://cicalino.net

# --- Web Push (VAPID) --- avisos al cliente con la pestaña en segundo plano
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@cicalino.net"

# --- Rate limit distribuido (Upstash Redis) ---
# Recomendado en Vercel Production para cupo global entre lambdas.
# Si falta o Redis cae, la app sigue con límite en memoria (no corta
# pedidos / espera / push con 429 falsos).
# upstash.com → Redis → REST URL + token
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Marca el entorno como "debería tener Redis" (solo loggea; no tumba el servicio).
# RATE_LIMIT_REQUIRE_UPSTASH="1"

# --- CSP --- OPCIONAL. Sin esto la CSP va en Report-Only (no bloquea).
# En Vercel Production, cuando la consola del browser no muestre violaciones:
#   CSP_ENFORCE=1
# Si algo se rompe al enforcear: volvé a "" o borrá la var.
CSP_ENFORCE=""

# --- Resend (emails) --- OPCIONAL: si falta, el flujo de leads funciona igual
# (la solicitud queda en el panel de Superadmin y respondés a mano).
RESEND_API_KEY=""
RESEND_FROM="Cicalino <info@cicalino.net>"
LEAD_NOTIFY_EMAIL="info@cicalino.net"
# Cron de cobros (Vercel Cron → /api/cron/cobros).
# REQUERIDA: sin esto el endpoint devuelve 500 y el job no corre.
# Vercel la manda sola como "Authorization: Bearer <valor>" al invocar el cron.
# Generar con: openssl rand -base64 32
CRON_SECRET=""

# --- Sentry (monitoreo de errores) --- OPCIONAL: sin DSN no reporta nada y la
# app funciona igual. La integración de Vercel deja estas variables puestas.
# Ojo: verificá que quede una con prefijo NEXT_PUBLIC_. Sin esa, los errores
# del navegador (los del mostrador) no se reportan.
NEXT_PUBLIC_SENTRY_DSN=""
# Solo build, para subir source maps. SECRETA: va únicamente en Vercel.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Cloudflare Turnstile (anti-bot del formulario /probar) --- OPCIONAL
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# --- Mercado Pago ---
# Alias para transferencias (lo ve el cliente en /aceptar y en el mail).
NEXT_PUBLIC_MP_ALIAS="miguel.gua.mp"
# Pagos divididos: cobro online de cada restaurante con OAuth.
# Una sola aplicación de Cicalino en Mercado Pago (Tus integraciones):
#   - Redirect URL:   https://<tu dominio>/api/mp/oauth/callback
#   - Webhooks:       https://<tu dominio>/api/mp/webhook  (evento: Pagos)
# Sin las cuatro variables, Mercado Pago no se ofrece en ningún lado.
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
# Webhooks → "Clave secreta" de esa aplicación. Valida la firma x-signature.
MP_WEBHOOK_SECRET=""
# Cifra los tokens OAuth guardados en mp_cuentas (AES-256-GCM).
# Generar con: openssl rand -base64 32 — si se pierde, hay que reconectar las cuentas.
MP_TOKENS_KEY=""
