# ==========================================================================
# Cicalino - variables de entorno (PLANTILLA)
# Copiar a .env.local y completar con valores reales.
# ⚠️ NUNCA poner claves/contraseñas reales acá: .env.example SE COMMITEA a git.
# ==========================================================================

# --- Supabase (backend + auth + realtime) ---
# Dashboard del proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
# Publishable key (segura para el navegador). Debe ir con NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# SECRET key: SOLO server, NUNCA exponer ni commitear. Va únicamente en .env.local / Vercel.
# (también acepta el nombre viejo SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SECRET_KEY="sb_secret_xxx"

# --- Base de datos (solo para migraciones Drizzle en local) ---
# Supabase → Settings → Database → Connection string (pooler).
# Si la contraseña tiene caracteres especiales (& @ : / ?), codificalos (& = %26).
DATABASE_URL="postgresql://postgres:TU-PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# En Vercel: solo la URL limpia, sin espacios ni comentarios.
# Ej: https://cicalino.net

# --- Web Push (VAPID) --- avisos al cliente con la pestaña en segundo plano
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@cicalino.net"

# --- Rate limit distribuido (Upstash Redis) --- OPCIONAL pero recomendado en Vercel
# Sin esto, el límite de login/leads es por instancia (memoria). Con Upstash es global.
# upstash.com → Redis → REST URL + token
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- CSP --- OPCIONAL. Sin esto la CSP va en Report-Only (no bloquea).
# Cuando la consola esté limpia: CSP_ENFORCE=1
CSP_ENFORCE=""

# --- Resend (emails) --- OPCIONAL: si falta, el flujo de leads funciona igual
# (la solicitud queda en el panel de Superadmin y respondés a mano).
RESEND_API_KEY=""
RESEND_FROM="Cicalino <info@cicalino.net>"
LEAD_NOTIFY_EMAIL="info@cicalino.net"

# --- Cloudflare Turnstile (anti-bot del formulario /probar) --- OPCIONAL
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# --- Mercado Pago --- (etapa posterior, no prioritario aun)
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
