{
  "name": "cicalino",
  "version": "0.1.0",
  "private": true,
  "description": "Avisador de pedidos por QR para negocios gastronomicos chicos en Argentina.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:run": "vitest run",
    "test:db": "RUN_DB_CHECKS=1 vitest run --config vitest.integration.config.ts",
    "test:db:local": "node scripts/db-local-check.mjs",
    "db:security": "node scripts/db-apply-security.mjs",
    "db:sql": "node scripts/db-migrate.mjs",
    "db:sql:baseline": "node scripts/db-migrate.mjs --baseline",
    "test:e2e": "playwright test",
    "lint:fix": "eslint . --fix",
    "db:pull": "drizzle-kit pull",
    "presentacion:exportar": "node scripts/presentacion-offline/exportar.mjs",
    "presentacion": "node presentacion-offline/servidor.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.76.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.2",
    "next": "^16.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "//": "Overrides acotados al rango vulnerable de cada dependencia transitiva (pnpm audit, 24/10/2026): suben al parche corregido dentro de la misma versión mayor.",
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2",
      "fast-uri@<3.1.9": "^3.1.9",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "js-yaml@<4.3.2": "^4.3.2",
      "vite@<7.3.7": "^7.3.7",
      "esbuild@<0.25.0": "^0.25.12",
      "zod@<4.6.6": "^4.6.7"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "22.x"
  }
}
