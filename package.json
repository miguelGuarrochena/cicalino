{
  "name": "cicalino",
  "version": "0.1.0",
  "private": true,
  "description": "Avisador de pedidos por QR para negocios gastronomicos chicos en Argentina.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:run": "vitest run",
    "test:db": "RUN_DB_CHECKS=1 vitest run tests/integration",
    "db:security": "node scripts/db-apply-security.mjs",
    "test:e2e": "playwright test",
    "lint:fix": "eslint . --fix",
    "db:pull": "drizzle-kit pull"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.11",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "//": "postcss viene pinneado por next; forzamos la version parcheada (path traversal + lectura de archivos).",
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
